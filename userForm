Option Explicit

Dim reglas As Object ' Diccionario para almacenar las reglas
Dim checks As Object ' Diccionario para almacenar los checks

Private Sub optCorrecta_Click()

End Sub

' Cargar reglas y checks desde JSON al abrir el formulario
Private Sub UserForm_Initialize()
    Dim jsonText As String
    Dim jsonParsed As Object
    Dim jsonFile As String

    ' Ruta del archivo JSON (AJUSTA SEGÚN SEA NECESARIO)
    jsonFile = "C:\Users\USER\Documents\proyectos\a11y-help-VBAexcel\es.json"

    ' Leer JSON en UTF-8
    jsonText = LeerArchivoUTF8(jsonFile)

    ' Verificar si el archivo se leyó correctamente
    If jsonText = "" Then
        MsgBox "No se pudo leer el archivo JSON.", vbCritical, "Error"
        Exit Sub
    End If

    ' Convertir JSON a objeto
    Set jsonParsed = JsonConverter.ParseJson(jsonText)

    ' Verificar campos "rules" y "checks"
    If jsonParsed.Exists("rules") Then
        Set reglas = jsonParsed("rules")
    Else
        MsgBox "El archivo JSON no contiene reglas.", vbCritical, "Error"
        Exit Sub
    End If

    If jsonParsed.Exists("checks") Then
        Set checks = jsonParsed("checks")
    Else
        MsgBox "El archivo JSON no contiene checks.", vbCritical, "Error"
        Exit Sub
    End If

    ' Seleccionar por defecto la opción "Comportamiento esperado"
    optEsperado.Value = True
End Sub

' Filtrar resultados en tiempo real
Private Sub txtBuscar_Change()
    Dim clave As Variant
    Dim filtro As String
    filtro = LCase(txtBuscar.Text)

    lstResultados.Clear

    If optEsperado.Value Then
        For Each clave In reglas.Keys
            If reglas(clave).Exists("description") Then
                If InStr(1, LCase(reglas(clave)("description")), filtro) > 0 Then
                    lstResultados.AddItem clave & ": " & reglas(clave)("description")
                End If
            End If
        Next clave
    ElseIf optCorrecto.Value Then
        For Each clave In checks.Keys
            If checks(clave).Exists("pass") Then
                If InStr(1, LCase(checks(clave)("pass")), filtro) > 0 Then
                    lstResultados.AddItem clave & ": " & checks(clave)("pass")
                End If
            End If
        Next clave
    ElseIf optIncorrecto.Value Then
        For Each clave In checks.Keys
            If checks(clave).Exists("fail") Then
                If InStr(1, LCase(checks(clave)("fail")), filtro) > 0 Then
                    lstResultados.AddItem clave & ": " & checks(clave)("fail")
                End If
            End If
        Next clave
    End If
End Sub

' Insertar el texto seleccionado en la celda activa
Private Sub cmdInsertar_Click()
    If lstResultados.ListIndex <> -1 Then
        Dim seleccion As String
        Dim partes() As String

        seleccion = lstResultados.List(lstResultados.ListIndex)
        partes = Split(seleccion, ": ", 2)

        If UBound(partes) = 1 Then
            ActiveCell.Value = partes(1)
        Else
            ActiveCell.Value = seleccion
        End If

        Unload Me
    Else
        MsgBox "Por favor, selecciona una regla de la lista.", vbExclamation, "Atención"
    End If
End Sub

' Cerrar el formulario
Private Sub cmdCerrar_Click()
    Unload Me
End Sub

' Para que la búsqueda se actualice automáticamente cuando el usuario cambie entre los botones de opción
Private Sub optEsperado_Click()
    Call txtBuscar_Change
End Sub

Private Sub optCorrecto_Click()
    Call txtBuscar_Change
End Sub

Private Sub optIncorrecto_Click()
    Call txtBuscar_Change
End Sub
